# Instagram Saves Knowledge Dashboard Environment Configuration

# Application
NODE_ENV=development
PORT=3000
API_PORT=3001
WORKERS_PORT=3002

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/save_the_post

# Redis
REDIS_URL=redis://localhost:6379

# S3/MinIO Configuration
S3_BUCKET=save-the-post
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Instagram API (Optional - will use mock service if not provided)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_APP_ID=your_instagram_app_id_here
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here
ENABLE_MOCK_INSTAGRAM=true

# LLM Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Bot Tokens
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_application_id_here

# Search
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=masterKey

# Authentication
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Feature Flags
ENABLE_LLM_ENRICHMENT=true
ENABLE_VECTOR_SEARCH=true
ENABLE_BOT_INTEGRATIONS=true
ENABLE_IMPORT_EXPORT=true
